# Copy to .env and fill in. Never commit real secrets.
# Every variable the code actually reads is listed here; the "Platform" block is
# optional and only matters for the dormant Webdev realm (see the note above it).

# --- Database (required) -----------------------------------------------------
# MySQL-compatible. Schema and migrations live in shared/db/schema.ts and
# shared/db/*.sql; drizzle-kit writes new migrations from the schema.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/uptimepulse"

# --- Application (required) ---------------------------------------------------
# Key material for AES-256-GCM encryption of notification channel secrets.
# Must be at least 16 characters. Rotating it makes every stored Telegram token
# permanently unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPTIMEPULSE_ENCRYPTION_KEY=""

# --- Access -------------------------------------------------------------------
# The single operable account. Unset, the code falls back to the creator address
# hardcoded in server/auth/owner.ts. Set this for any deployment someone else
# runs: registration and every guarded route compare against this value.
UPTIMEPULSE_OWNER_EMAIL=""

# --- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Absolute origin used inside generated links (QA follow-up link, client reply
# templates). Set it as soon as the app runs behind a proxy: otherwise the value
# falls back to the request Host header, which a caller can forge.
APP_BASE_URL=""

# --- Scheduling ---------------------------------------------------------------
# The in-process scheduler does the real work locally and self-hosted: one tick
# every 30 s. Set to 0 to stop it (checks then only run through the heartbeat
# callback below, which needs the platform block to be configured).
SCHEDULER_INTERNAL=1

# --- Platform (optional, dormant realm) ----------------------------------------
# Consumed by the Webdev runtime. Nothing here is needed to run the product, and
# the local stack runs with all of it empty: the platform OAuth flow has no
# client-side entry point and heartbeat registration self-skips without
# MANUS_API_URL / MANUS_API_KEY. Keep them only if you deploy on that platform.
MANUS_PROJECT_ID=""
MANUS_JWT_SECRET=""
MANUS_OAUTH_API_URL=""
MANUS_OAUTH_PORTAL_URL=""
MANUS_API_BROWSER_KEY=""
MANUS_API_URL=""
MANUS_API_KEY=""

# Legacy hint that grants admin role to a matching platform openId during user
# upsert (server/db.ts). Unused for the email/password realm; leave empty.
OWNER_OPEN_ID=""
