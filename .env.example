# Copy to .env and fill in. Never commit real secrets.

# --- Database (required) -----------------------------------------------------
# MySQL-compatible. The schema is generated by drizzle-kit from drizzle/schema.ts.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/uptimepulse"

# --- Application (required) ---------------------------------------------------
# Key material for AES-256-GCM encryption of notification channel secrets.
# Rotating it makes every stored Telegram token permanently unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPTIMEPULSE_ENCRYPTION_KEY=""

# --- Platform -----------------------------------------------------------------
# Consumed by the Webdev runtime. The local stack runs without it; the scheduler
# registers its cron through the platform API.
MANUS_PROJECT_ID=""
MANUS_JWT_SECRET=""
MANUS_OAUTH_API_URL=""

# --- Server -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Absolute origin used inside generated links (QA follow-up link, client reply
# templates). Set it as soon as the app runs behind a proxy: otherwise the value
# falls back to the request Host header, which a caller can forge.
APP_BASE_URL=""
