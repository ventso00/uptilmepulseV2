{
  "name": "uptimepulse",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch backend/_core/index.ts",
    "build": "vite build && node scripts/build-serverless.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings .",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "dev:static": "vite --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "build:static": "vite build"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.8",
    "@trpc/server": "^11.8.0",
    "@uptimepulse/shared": "workspace:*",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "ipaddr.js": "^2.5.0",
    "jose": "6.1.0",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.22.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.18.0"
}
